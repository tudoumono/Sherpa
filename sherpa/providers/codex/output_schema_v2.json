{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "answer", "next_step", "claims", "reconciliation"],
  "properties": {
    "status": {"type": "string", "enum": ["final", "in_progress"]},
    "answer": {"type": "string"},
    "next_step": {"type": ["string", "null"]},
    "reconciliation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "spec_text", "spec_ref", "source_text", "source_ref", "verdict"],
        "properties": {
          "item": {"type": "string"},
          "spec_text": {"type": "string"},
          "spec_ref": {"type": "string"},
          "source_text": {"type": "string"},
          "source_ref": {"type": "string"},
          "verdict": {"type": "string", "enum": ["match", "mismatch", "spec_missing", "source_missing"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "text", "evidence_refs", "reason", "reason_code", "evidence_kinds", "item_ids"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["confirmed", "inferred", "unknown"]},
          "text": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"},
          "reason_code": {
            "type": "string",
            "enum": ["", "not_found_in_scope", "unexplored", "insufficient", "conflict", "budget", "unreadable"]
          },
          "item_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["source", "spec_doc", "definition", "log_config", "callgraph"]
            }
          }
        }
      }
    }
  }
}
