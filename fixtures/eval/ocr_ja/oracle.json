        {"check_id": "hybrid:normal", "label": "取消金額行", "bbox": [62, 321, 782, 397], "terms": [{"text": "取消金額", "kind": "text"}, {"text": "1,000,000円", "kind": "number"}, {"text": "受付を継続", "kind": "text"}, {"text": "なし", "kind": "text"}]},
        {"check_id": "hybrid:over", "label": "上限超過行", "bbox": [62, 397, 782, 473], "terms": [{"text": "上限超過", "kind": "text"}, {"text": "1,000,000円超", "kind": "number"}, {"text": "更新せず終了", "kind": "text"}, {"text": "E-HYB-301", "kind": "identifier"}]},
        {"check_id": "hybrid:note", "label": "現行上限の否定付き注記", "bbox": [62, 518, 778, 623], "terms": [{"text": "現行仕様", "kind": "status"}, {"text": "100万円", "kind": "number"}, {"text": "50万円ではない", "kind": "number"}]}
