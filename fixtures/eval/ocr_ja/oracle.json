        {"check_id": "hybrid:title", "label": "現行文書名と文書ID", "bbox": [36, 36, 804, 128], "terms": [{"text": "現行", "kind": "status"}, {"text": "取消制御設計書", "kind": "text"}, {"text": "H-PDF-301", "kind": "identifier"}]},
        {"check_id": "hybrid:screen", "label": "画面ID", "bbox": [36, 128, 804, 225], "terms": [{"text": "画面ID", "kind": "text"}, {"text": "SCR-PDF-01", "kind": "identifier"}]},
