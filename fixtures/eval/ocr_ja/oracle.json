        {"check_id": "office:header", "label": "表ヘッダー", "bbox": [20, 78, 620, 112], "terms": [{"text": "項目ID", "kind": "text"}, {"text": "表示名", "kind": "text"}, {"text": "制約", "kind": "text"}, {"text": "状態", "kind": "text"}]},
        {"check_id": "office:account", "label": "ACCOUNT_NO行", "bbox": [20, 112, 620, 151], "terms": [{"text": "ACCOUNT_NO", "kind": "identifier"}, {"text": "口座番号", "kind": "text"}, {"text": "7桁", "kind": "number"}, {"text": "現行", "kind": "status"}]},
        {"check_id": "office:old", "label": "OLD_CODE行", "bbox": [20, 151, 620, 190], "terms": [{"text": "OLD_CODE", "kind": "identifier"}, {"text": "旧受付区分", "kind": "text"}, {"text": "2桁", "kind": "number"}, {"text": "廃止", "kind": "status"}]},
        {"check_id": "office:flow", "label": "処理IDと名称", "bbox": [40, 214, 590, 270], "terms": [{"text": "A01", "kind": "identifier"}, {"text": "入力検証", "kind": "text"}, {"text": "A02", "kind": "identifier"}, {"text": "更新確定", "kind": "text"}]},
