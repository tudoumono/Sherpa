# Sherpa — 環境変数のひな型
#
# 開発機: cp .env.example .env（`make bootstrap` が自動でコピー）
# 本番:   cp .env.example /etc/sherpa/sherpa.env（SHERPA_ENV_FILE で指定）し、まず「0. 本番チェックリスト」を埋める
# 優先順: コマンドラインの指定 ＞ この env ファイル ＞ 既定
# 書き方: 有効な行は既定値のまま動く値。「# 」の行は必要なときだけ外す。
# 管理画面で変えられる値（AI の接続先・調べる深さなど）はここに書かない（管理画面で設定する）。
# 例外は OPENAI_API_KEY（Codex CLI のログインに使うため「1.」に置く）。
# 全変数の説明: docs/manual/90-リファレンス.md

# ============================================================================
# 0. 本番チェックリスト（CHANGE_ME が残っていると本番は起動しない）
# ============================================================================
# SHERPA_ENV=production
# SHERPA_ADMIN_PASSWORD=Sherpa2026!
# SHERPA_AUDIT_IP_SALT=CHANGE_ME_LONG_RANDOM_SALT
# POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
# SHERPA_KB_DIR=/srv/sherpa/kb
# SHERPA_DERIVED_DIR=/srv/sherpa/derived
# SHERPA_USERS_DIR=/srv/sherpa/users

# ============================================================================
# 1. 接続先・置き場（インフラ）
# ============================================================================
# --- アプリ・ログイン ---
SHERPA_ADMIN_PASSWORD=Sherpa2026!
SHERPA_BROWSE_ROOTS=/mnt:/srv:/home:/Users
SHERPA_HOST=127.0.0.1
SHERPA_PORT=8000
SHERPA_LAN=1
SHERPA_UVICORN_WORKERS=1
SHERPA_COOKIE_SECURE=
SHERPA_AUDIT_IP_SALT=change-me

# --- Codex CLI の認証（OpenAI のキー・空のまま配布する） ---
OPENAI_API_KEY=

# --- PostgreSQL / Neo4j / Elasticsearch ---
POSTGRES_PASSWORD=sherpa_dev
NEO4J_USER=neo4j
NEO4J_PASSWORD=sherpa_dev
PGPORT=5432
SHERPA_ES_PORT=9200
SHERPA_NEO4J_BOLT_PORT=7687
SHERPA_NEO4J_HTTP_PORT=7474
# グラフを1回のトランザクションで書く件数（既定1000）。MemoryPoolOutOfMemoryError のときはまず小さくする
# SHERPA_NEO4J_WRITE_BATCH_ROWS=500
# Neo4j のメモリは起動のたびに自動で決まる（8GB 以上の機械ではヒープ＝全体の 8%）。小分けにしても足りないときは、
# ここでヒープを増やす（4g・4096m の形。他の部品の割り振りは自動のまま）
# SHERPA_NEO4J_HEAP_FIXED=3g
# SHERPA_NEO4J_PAGECACHE_FIXED=1g
# 1 回の書き込みの上限（既定はヒープの 70%）。ヒープ以下の値か、0（無制限）
# SHERPA_NEO4J_TX_MEMORY_MAX=2g
SHERPA_COMPOSE_PROJECT=sherpa-mvp
# 別ホストのストア
# DATABASE_URL=postgresql://sherpa:sherpa_dev@localhost:5432/sherpa
# ES_URL=http://localhost:9200
# NEO4J_URI=bolt://localhost:7687
# PGHOST=localhost
# PGUSER=sherpa
# PGPASSWORD=sherpa_dev
# PGDATABASE=sherpa
# SHERPA_PG_DSN=host=db-host port=5432 dbname=sherpa user=sherpa password=sherpa_dev
# SHERPA_PG_POOL_MIN=2
# SHERPA_PG_POOL_MAX=10
# SHERPA_PG_POOL_TIMEOUT=10

# --- データの置き場（本番は /opt/sherpa の外の固定パス） ---
SHERPA_KB_DIR=./data/kb
SHERPA_USERS_DIR=./data/users
SHERPA_DERIVED_DIR=./data/derived
SHERPA_OBSERVATION_DIR=./data/observations
SHERPA_OCR_MODEL_CACHE=./data/ocr-models
SHERPA_BACKUP_DIR=./data/backups
# ログ・pid の置き場（1 か所・相対パスは Sherpa のフォルダ基準）。SHERPA_LOG_DIR は廃止
# RUN_DIR=data/run
# MD 化で派生物を作れなかった文書が、候補のこの割合を超えたら管理画面で知らせる（既定 0.1＝1 割。何件失敗しても取り込みは止めず、その文書だけを欠いたまま全文検索・埋め込みへ進み、次の更新で作り直す）
# SHERPA_DERIVED_FAIL_WARN_RATIO=0.1

# --- OCR（画像内文字の読み取り） ---
# OCR の入切は管理画面（取り込みタブ）で決める（既定は切）。ここに 0 を書いたときだけ切に固定される（1 や未設定は画面の設定に従う）
# SHERPA_OCR_ENABLED=0
SHERPA_OCR_WORLD_ROOT=
SHERPA_OCR_UID=1000
SHERPA_OCR_GID=1000
# OCR の検出・推論の資源（既定はメモリ 16GB でも入る小さい値。値を変えると、同じ画像を読み直す）
# SHERPA_OCR_DET_LIMIT_TYPE=max       # max＝長辺を下の値まで縮小して検出する
# SHERPA_OCR_DET_LIMIT_SIDE_LEN=1280  # 大きい機械では 1600〜2560
# SHERPA_OCR_REC_BATCH_SIZE=1         # 大きい機械では 2〜6
# SHERPA_OCR_MAX_PIXELS=40000000      # 1 枚の画素数の上限。超える入力は失敗（再試行しない）にする。値を変えると、上限超過で失敗した入力を読み直す
# SHERPA_OCR_MAX_INPUT_BYTES=67108864 # 1 枚の入力バイト数の上限（64MiB）。同上
# SHERPA_OCR_MEMORY_LIMIT=2g   # 書くと上限になる（全体のメモリからの自動計算より大きくはならない。既定は全体の 1/4・4〜8GB）
# SHERPA_OCR_MAX_IMAGE_SIDE=2560   # 読み取る前に、これより長い辺の画像を縦横比のまま縮める（256〜16384）
# SHERPA_OCR_MAX_IMAGE_PIXELS=6000000   # 総画素数の上限（これを超える画像も縮める）。値を変えると、同じ画像を読み直す
# SHERPA_OCR_MEMORY_FIXED=12g  # 書くと OCR 1 本あたりの上限をこの値にする（自動計算より大きくできる。残りが足りないと警告）
# SHERPA_OCR_WORKERS=2         # OCR ワーカーの本数（既定 1）。1 本あたりの上限×本数がメモリ・CPU に収まらない分は減らす
# SHERPA_OCR_MODEL=small       # 読み取りのモデル。small（既定・軽くて速い）・medium（精度優先で重い）・mobile（旧世代の軽い版）。変えると同じ画像を読み直す。どれも make ocr-models で入る
# SHERPA_OCR_ONEDNN=0          # 1 で oneDNN（Intel CPU 向けの高速化）を使う。変えると同じ画像を読み直す。固定している Paddle 3.3.0 では推論が失敗するため 0 のまま
# SHERPA_OCR_CPUS=2            # OCR ワーカー 1 本あたりの CPU の上限。書かなければ機械の CPU の半分を本数で割った値
# SHERPA_OCR_THREADS=2         # OCR ワーカー 1 本あたりの推論スレッド数。書かなければ上の CPU の上限と同じ
# SHERPA_OCR_IDLE_UNLOAD_SECONDS=300   # 読み取りの仕事が来ない時間がこの秒数続いたら、モデルを手放してメモリを返す（次の仕事で読み込み直す）。0 で手放さない

# --- 起動・停止・更新 ---
SHERPA_APP_WAIT=30
SHERPA_STORE_WAIT=120
# 停止（make stop / restart / restart-worker）で取り込みワーカーが処理中の 1 件の完了を待つ上限秒（シェルの環境変数で指定・既定 1800）。FORCE=1 make stop は待たずに強制終了
# SHERPA_STOP_WAIT=1800
# 取り込みワーカー（Web アプリとは別プロセス）の優先度（nice の値 0〜19・既定 10）。先読み・LibreOffice の子も引き継ぐ
# SHERPA_INGEST_NICE=10
# 取り込みワーカーが待機中に依頼を確かめる間隔（秒・既定 2）
# SHERPA_INGEST_POLL_SEC=2
# make ingest-status の読み取り1回あたりの上限秒（既定 10）。超えた欄は「時間内に読めませんでした」と出し、残りは表示を続ける
# SHERPA_INGEST_STATUS_TIMEOUT_SEC=10
# glibc の malloc の領域数（既定 2・Linux のみ効く）。解放済みメモリが OS に戻りやすくなる
# MALLOC_ARENA_MAX=2
# 取り込みワーカーが起動時に、中断していた取り込みの続きを自動で始める（既定 1・0 で無効）
# SHERPA_RESUME_INTERRUPTED=1
SHERPA_SKIP_PORT_CHECK=0
SHERPA_BACKUP_BEFORE_SWITCH=1

# --- プロキシ・社内 CA ---
# HTTP_PROXY=http://proxy.internal:8080
# HTTPS_PROXY=http://proxy.internal:8080
# ALL_PROXY=socks5://proxy.internal:1080
# NO_PROXY=localhost,127.0.0.1,::1
# http_proxy=
# https_proxy=
# all_proxy=
# no_proxy=
# SSL_CERT_FILE=/etc/ssl/certs/corp-ca.pem
# SSL_CERT_DIR=/etc/ssl/certs
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# CURL_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-ca.pem

# --- 外部ツール（未設定なら自動検出） ---
# SHERPA_MARP_BIN=/path/to/marp
# CHROME_PATH=/path/to/chrome
# SHERPA_SOFFICE_BIN=/usr/bin/soffice
# SHERPA_POWERSHELL_BIN=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
# SHERPA_OFFICE_COM_URL=http://127.0.0.1:8091
# SHERPA_OFFICE_COM_TOKEN=
# SHERPA_OFFICE_TRANSFER_MODE=path

# ============================================================================
# 2. 大きな資料・遅い環境のときだけ変える値
# ============================================================================
# --- 取り込みのサイズ上限 ---
# SHERPA_OFFICE_FILE_CAP_BYTES=104857600
# SHERPA_PDF_FILE_CAP_BYTES=104857600
# SHERPA_OFFICE_UNCOMPRESSED_CAP_BYTES=524288000
# SHERPA_XLSX_CELL_CAP=2000000
# SHERPA_LEGACY_TIMEOUT=60
# SHERPA_LEGACY_BATCH=16   # 旧形式の先変換で 1 回の soffice 起動にまとめる件数（1〜256）
# SHERPA_LEGACY_WORKERS=3   # 旧形式の先変換の並列数（0〜8・0 で先変換しない。未設定は MD化の先読みと同じ本数）
# SHERPA_MD_WORKERS=3   # MD化を並列に先読みするプロセス数（1〜8・1 で直列。未設定は CPU 数に応じて最大 4）
# SHERPA_MD_PLAN_THREADS=8   # MD化の前の確認（キャッシュ照合・上限チェック）を並列にするスレッド数（1〜32・1 で直列）
# --- 画像の読み取り ---
# SHERPA_OCR_MAX_PAGES=20
# SHERPA_VLM_TIMEOUT=180
# SHERPA_VLM_MAX_IMAGE_MB=20
# --- 検索・原本の読み取り ---
# SHERPA_GREP_FILE_CAP_BYTES=67108864
# SHERPA_READ_AROUND_FILE_CAP_BYTES=67108864
# SHERPA_DOC_READ_MAX_BYTES=52428800
# SHERPA_DOC_READ_MAX_UNZIP_BYTES=209715200
# SHERPA_DOC_READ_MAX_SECONDS=10
# SHERPA_NEO4J_QUERY_TIMEOUT_S=30
# SHERPA_GRAPH_ANCHOR_MAX=50
# --- 外部連携 API ---
# SHERPA_EXT_CONVERT_MAX_BYTES=52428800
# SHERPA_EXT_DOC_MAX_BYTES=52428800
# --- 稼働確認 ---
# SHERPA_HEALTH_AI_TIMEOUT=8

# ============================================================================
# 3. 緊急時・開発用（通常は設定しない）
# ============================================================================
# SHERPA_CODEX_SANDBOX=1
# SHERPA_CODEX_AUTO_CONTINUE=3
# SHERPA_CODEX_OUTPUT_SCHEMA=2
# SHERPA_CODEX_WALL_CLOCK_LIMIT_S=5400
# MCP の道具 1 回の制限時間（秒・既定 120・上限 280。Codex CLI の道具の待ち上限 300 秒より短くする）
# SHERPA_MCP_TOOL_DEADLINE_SEC=120
# SHERPA_DISABLE_EMBED=1
# SHERPA_USE_FIXTURES=1
# SHERPA_AUTH_DISABLED=1
