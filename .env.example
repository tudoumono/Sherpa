# Sherpa — 環境変数のひな型（開発・本番共通の唯一の例＝ENV-ONE・2026-09-03一本化）
#
# 使い方:  開発機（WSL）は  cp .env.example .env  してから編集する（`make bootstrap` が自動でコピー）。
#          本番（閉域サーバ含む）は  cp .env.example /etc/sherpa/sherpa.env  してから、まず本ファイル
#          冒頭の「0. 本番チェックリスト」節を必ず設定する。.env／sherpa.env は git 管理外
#          （秘密はコミットしない）。
# 読み方:  全スクリプト共通で「コマンドラインの明示指定 ＞ この .env ＞ 既定」。別ファイルにしたいときは
#          SHERPA_ENV_FILE=<パス>（本番は /etc/sherpa/sherpa.env）。Makefile／scripts/run-common.sh／
#          scripts/doctor.sh の3か所が同じ既定 `.env` を見る。docker compose にも同じファイルが渡る。
# 書き方:  既定値は**そのまま有効な行**として書いてある（＝このファイルのままで開発機は動く）。
#          「# 」で始まる行は「必要なときだけ外す」もの（別ホストへの接続・秘密・内部用）。
# 選び間違いガード: `SHERPA_ENV=production` で env に `CHANGE_ME` を含む値・開発既定のままの
#          `SHERPA_ADMIN_PASSWORD` があると起動を拒否する（`make prod-check` でも事前検知できる）。
#          閉域網へ持ち出す前に「0.」の各項目を実際の値へ書き換えること。
# AI の鍵と接続先: 管理画面（頭脳）で設定する（system_settings）。OPENAI_API_KEY は本ファイルには
#          置かない——ただし閉域キット導入時の Codex CLI 自己認証専用として、空のままの有効行だけ
#          残してある（下記「4. AI（頭脳）」参照。プレースホルダは入れない＝空のまま）。
# 詳しい説明: docs/manual/90-リファレンス.md（全変数の一覧）

# ============================================================================
# 0. 本番（閉域サーバ）チェックリスト — 本番ではこの節の項目を必ず設定する
# ============================================================================
# SHERPA_ENV=production            # 本番ガード有効化（fixtures拒否・AUTH_DISABLED無効化・CHANGE_ME/開発既定パスワード拒否・serve必須）
# SHERPA_ADMIN_PASSWORD=Sherpa2026!   # 既定のままでも可（初回ログインで変更を強制）・変えるならここで
# SHERPA_AUDIT_IP_SALT=CHANGE_ME_LONG_RANDOM_SALT
# POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD    # PGPASSWORD も同値に（下記「2. ストア」参照）
# NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
# SHERPA_KB_DIR=/srv/sherpa/kb
# SHERPA_DERIVED_DIR=/srv/sherpa/derived
# SHERPA_USERS_DIR=/srv/sherpa/users

# ============================================================================
# 1. まず触るもの
# ============================================================================
# 初期 admin パスワード（初回ログインで変更を強制・本番は「0.」で必ず実際の値に変更する）
SHERPA_ADMIN_PASSWORD=Sherpa2026!
# 資料フォルダ選択のルート（`:`区切り・既定=/mnt:/srv:/home。/ は不可＝登録は共有KBへの公開）
SHERPA_BROWSE_ROOTS=/mnt:/srv:/home
# アプリ待受
SHERPA_HOST=127.0.0.1
SHERPA_PORT=8000
SHERPA_LAN=1
# セッション cookie の Secure（空=HTTPS で来たときだけ・1=常に付ける）
SHERPA_COOKIE_SECURE=

# アプリ本体（Python 標準の urllib＝OpenAI/Gemini/Ollama/ES への HTTP はすべてこれ）も Codex CLI も、下の
# 標準変数を**環境から**そのまま読む（urllib は HTTP_PROXY/HTTPS_PROXY/NO_PROXY と SSL_CERT_FILE/SSL_CERT_DIR、

# ============================================================================
# 2. ストア（PostgreSQL / Neo4j / Elasticsearch）
# ============================================================================
# DB パスワード（本番は「0.」で必ず実際の値に変更する）
POSTGRES_PASSWORD=sherpa_dev
NEO4J_USER=neo4j
NEO4J_PASSWORD=sherpa_dev
# ストアのポート（compose の公開ポート＝アプリの接続先）
PGPORT=5432
SHERPA_ES_PORT=9200
SHERPA_NEO4J_BOLT_PORT=7687
SHERPA_NEO4J_HTTP_PORT=7474
# compose プロジェクト名
SHERPA_COMPOSE_PROJECT=sherpa-mvp
# 別ホストのストア用（URL で丸ごと指定・デフォルトはコメントアウト）
# DATABASE_URL=postgresql://sherpa:sherpa_dev@localhost:5432/sherpa

# ============================================================================
# 3. データの置き場
# ============================================================================
# 本番は /opt/sherpa の外の固定パスへ（例:/srv/sherpa/...）
SHERPA_KB_DIR=./data/kb
SHERPA_USERS_DIR=./data/users
SHERPA_DERIVED_DIR=./data/derived
SHERPA_OBSERVATION_DIR=./data/observations
SHERPA_OCR_MODEL_CACHE=./data/ocr-models
SHERPA_BACKUP_DIR=./data/backups
SHERPA_UID=admin
SHERPA_VERSION=v1

# ============================================================================
# 4. AI（頭脳）
# ============================================================================
# 鍵・接続先（OpenAI/Azure OpenAI/Gemini/Bedrock の API キー・エンドポイント・埋め込みモデル名）は
SHERPA_EXTRA_AGENTS=
# Codex CLI 自身の認証専用（閉域キット導入時に自動ログインで使う）。アプリ本体の OpenAI キーは
# 上と同じく管理画面で設定する——このキーはそれとは別経路。空のまま配布し、値を入れない限り無害。
OPENAI_API_KEY=
# 頭脳の選択（既定は自動選択）。単独では選べない値（heuristic/gemini/bedrock）は
# SHERPA_EXTRA_AGENTS も併記しないと既定へ戻る。閉域で実際に動く3通り:
# SHERPA_AGENT=codex        # 1) OpenAI直結・Codex CLI（上の OPENAI_API_KEY で自動認証）
# SHERPA_AGENT=ollama       # 2) 外へ出られない・ローカルLLM（OLLAMA_URL を自ホストに合わせる）
# SHERPA_AGENT=heuristic
# SHERPA_EXTRA_AGENTS=heuristic   # 3) 簡易（AIなし）——上の2行を対で有効化する
# ローカルLLM（Ollama）の接続先。初回起動時に管理画面（system_settings の中央既定値）へ
OLLAMA_URL=http://localhost:11434
# HTTP 系プロバイダ（OpenAI/Ollama/Gemini）呼び出しのタイムアウト秒。探索を深くする分だけ
SHERPA_LLM_TIMEOUT=240
# AWS Bedrock の SigV4 認証（Bearer キーが無い場合の代替）。Sherpa のコードは AWS_SECRET_ACCESS_KEY を
SHERPA_HISTORY_TURNS=6
SHERPA_HISTORY_MSG_CHARS=1200
SHERPA_HISTORY_CHAR_BUDGET=6000
# エージェント検索（grep 反復）の上限。下の2つは精度優先の既定に引き上げ済み
SHERPA_AGENTIC_MAX_TURNS=24
SHERPA_AGENTIC_MAX_TOOLS_PER_TURN=32
# BUDGET-1/2（2026-09-02-RAG表現の全形式展開と文脈保持.md §3.4）: ツール結果1件／1回の調査累計の
SHERPA_GREP_FILE_CAP_BYTES=67108864
SHERPA_GREP_HIT_TEXT_MAX_BYTES=65536
# 改行が来ないまま伸び続ける単一行の保持上限（65536〜16777216・既定2097152＝2MiB）。この上限を
SHERPA_GREP_LINE_MAX_BYTES=2097152
# read_around/read_doc/doc_outline がディスクから読む生バイト数の上限（65536〜67108864）。
SHERPA_READ_AROUND_FILE_CAP_BYTES=67108864
# ES 索引の legacy チャンク粒度（行・既定40・変更で全 world reindex）
# SHERPA_ES_CHUNK_LINES=40
# ES ハイブリッド検索の BM25/kNN 配分（既定0.5・範囲0.0-1.0）
# SHERPA_ES_HYBRID_WEIGHT=0.5
# read 側（read_around/read_doc/doc_outline）の単一巨大行の保持上限（65536〜16777216・既定
SHERPA_READ_LINE_MAX_BYTES=2097152
# Office/PDF 取り込みの入口サイズガード（MEM-1・実環境 OOM 障害対応・1048576〜1073741824）。
SHERPA_OFFICE_FILE_CAP_BYTES=104857600
SHERPA_PDF_FILE_CAP_BYTES=104857600
# xlsx セル数ガード（MEM-2・st_sizeは圧縮後サイズのため圧縮爆弾を素通りする・1000〜100000000）。
SHERPA_XLSX_CELL_CAP=2000000
# Office 非圧縮サイズガード（MEM-2・docx/pptx含む3形式＋旧形式変換後・1048576〜4294967296）。
SHERPA_OFFICE_UNCOMPRESSED_CAP_BYTES=524288000
# per-file 変換結果キャッシュの総量上限（CONV-CACHE・実環境の取り込み途中死からの再開対応・
SHERPA_CONV_CACHE_MAX_BYTES=0
# --- 検索表現（RAG 表現を使うか・推奨は両方 1）------------------------------
SHERPA_SUB_PLAN_MAX_CALLS=24
SHERPA_SUB_PLAN_MAX_STEPS=3
# 検索経路トグル（grep/全文/グラフ）の実接続可用性チェックの process-local キャッシュ TTL 秒
SHERPA_TOOLS_AVAILABILITY_TTL=20
# グラフ検索（Neo4j）の per-query タイムアウト秒／結果行数の緊急天井（安全弁・既定のまま据え置く）。
SHERPA_NEO4J_QUERY_TIMEOUT_S=30
SHERPA_NEO4J_MAX_ROWS=10000
# GRAPH-MEM: world 反映（load_world）のノード/エッジ投入バッチ行数（1〜1000000・既定のまま据え置く）。
SHERPA_NEO4J_BATCH_ROWS=5000
# チャットの思考ステップ表示の間隔秒。
SHERPA_STREAM_PACE=0.35
# EXT-2: エージェント検索の引用（citation）を Committed Evidence へ確定する直前の機械検証
SHERPA_AGENTIC_EVAL_CYCLE_TURNS=3
# 精度に直結するコード内定数の env 化。探索の深さに関わる4つは精度優先の既定で有効化済み
SHERPA_GREP_MAX_HITS=45
# read_around（精読）の窓の行数（10〜400・コード既定40）。LLM 入力窓のハード上限（既定200）は
SHERPA_READ_WINDOW=60
# 影響たどり（impact）の既定深さ（1〜64・コード既定8）。外部 API `depth` の上限（既定12）は
SHERPA_IMPACT_MAX_DEPTH=10
# トラブルシュート/近傍探索の既定深さ（1〜16・コード既定3）。
SHERPA_TROUBLESHOOT_GRAPH_DEPTH=4
# ES 索引の legacy チャンク粒度（行・10〜400・コード既定40）。**変更すると次回 sync で全 world が
# 自動 reindex される**ため、実測なしでは触らない（コメントアウトのまま配布）。

# ============================================================================
# 5. Codex（Codex 構成を選んだとき）
# ============================================================================
# Codex に MCP 経由で検索/グラフのツールを渡す（1）。0 で旧・事実前渡し経路（緊急時の逃げ道）。
SHERPA_CODEX_MCP=1
# Codex CLI の read-only サンドボックス（1）。0 で `-s workspace-write` にフォールバック（緊急時のみ）。
SHERPA_CODEX_SANDBOX=1
# 推論深さの既定（設定画面/チャットの指定が優先）。精度優先の既定 xhigh に引き上げ済み
SHERPA_CODEX_REASONING=xhigh
SHERPA_CODEX_TIMEOUT=180
# 資料作成（author）専用の推論深さ／タイムアウト秒。
SHERPA_CODEX_REASONING_AUTHOR=medium
SHERPA_CODEX_TIMEOUT_AUTHOR=600
# Codex の web_search を管理者が許可する（初回シードのみ・以後は管理画面「プロバイダ＋接続先」タブで
SHERPA_ALLOW_WEB_SEARCH=0
# marp CLI / Chromium の明示パス（未設定なら自動検出＝通常は不要。空文字にすると自動検出が止まるので外したまま）。
# SHERPA_MARP_BIN=/path/to/marp

# ============================================================================
# 6. 取り込み（Office/PDF → Markdown）
# ============================================================================
# 有効化する変換アーム（カンマ区切り）。ooxml=docx/pptx/xlsx（常時）／pdf_text=PDF テキスト層／
SHERPA_ARMS=ooxml,pdf_text
# PDF テキスト層「十分」の判定しきい値（ページあたり平均抽出文字数）。未満は vision へエスカレーション。
SHERPA_PDF_TEXT_MIN_CHARS=30
# vision が PDF をページ画像化する上限ページ数／最長辺ピクセル。
SHERPA_OCR_MAX_PAGES=20
SHERPA_OCR_MAX_PIXELS=4000
# vision の VLM。既定ローカル（Ollama）。クラウド（OpenAI）への送信はシステム管理画面の cloud_allowed で
SHERPA_VLM_OLLAMA_URL=http://localhost:11434
SHERPA_VLM_TIMEOUT=180
SHERPA_VLM_MAX_IMAGE_MB=20
# 旧形式（.doc/.xls/.ppt）の変換: none（未対応表示）| libreoffice（Linux の soffice）| office_com（Windows 側の Office）。
SHERPA_LEGACY_BACKEND=none
SHERPA_LEGACY_TIMEOUT=60
# soffice の明示パス（未設定なら PATH から探す＝通常は不要）。
SHERPA_POLL_SECONDS=0
# 検索用ベクトル化を止める（テスト用・**設定した時点で無効になる**ので通常は外したまま）。
# SHERPA_DISABLE_EMBED=1

# ============================================================================
# 7. 画像内文字の読み取り（OCR・既定ON）
# ============================================================================
# 0 で止める（取り込み・検索は従来どおり動き、画像の中の文字だけ読まれない）。モデルは make ocr-models。
SHERPA_OCR_ENABLED=1
# OCR ワーカーへ読み取り専用で渡す資料フォルダの親（絶対パス・symlink 不可）。空＝登録済みの1本から自動。
SHERPA_OCR_WORLD_ROOT=
# ワーカーコンテナの実行 uid/gid とメモリ上限。
SHERPA_OCR_UID=1000
SHERPA_OCR_GID=1000
SHERPA_OCR_MEMORY_LIMIT=8g

# ============================================================================
# 8. 認証・個人領域
# ============================================================================
# 監査ログの IP hash 用 salt（本番は必ずランダムな値にする）。
SHERPA_AUDIT_IP_SALT=change-me
# セッションの有効日数。
SHERPA_SESSION_DAYS=7
# 個人ファイルの上限バイト数／有効期限（日・0 で無期限）。外部連携 API のアップロード上限。
SHERPA_WORKSPACE_MAX_BYTES=10485760
SHERPA_WORKSPACE_TTL_DAYS=90
SHERPA_EXT_CONVERT_MAX_BYTES=52428800
# GET /ext/v1/doc が配信を許す原本ファイルの上限バイト数。
SHERPA_EXT_DOC_MAX_BYTES=52428800
# 監査書込み専用 DB 接続のタイムアウト・queue 上限（dev チューニング・通常は既定値のままでよい）。
SHERPA_EXT_AUDIT_DB_CONNECT_TIMEOUT_S=5
SHERPA_EXT_AUDIT_DB_LOCK_TIMEOUT_MS=3000
SHERPA_EXT_AUDIT_DB_STATEMENT_TIMEOUT_MS=5000
SHERPA_EXT_AUDIT_QUEUE_MAXSIZE=1000
# 開発・検証互換用（全リクエストを admin 扱い）。通常利用では設定しない。
# SHERPA_AUTH_DISABLED=1

# ============================================================================
# 9. 運用（起動・監視・更新・バックアップ）
# ============================================================================
# uvicorn のワーカー数。
SHERPA_UVICORN_WORKERS=1
# ログの起動時退避（LOG-2）: 前回ログ（run/caddy/サブシステム別）は起動のたびに上書きせず、
SHERPA_LOG_KEEP=10
# サブシステム別ログ（LibreOffice 変換・MD 変換・LLM 埋め込み）の出力先ディレクトリ。既定は run
SHERPA_APP_WAIT=30
SHERPA_STORE_WAIT=120
SHERPA_STOP_WAIT=10
# ポート占有検査を省略する（1・整合検査は残る）。docker が使えない環境で誤検知するときだけ。
SHERPA_SKIP_PORT_CHECK=0
# 更新（--target-dir）時、current 切替前の自動バックアップ（1＝取る）。
SHERPA_BACKUP_BEFORE_SWITCH=1
# ヘルスチェック（状態ドット・/health/summary・/admin/health）のキャッシュ TTL とタイムアウト秒。
SHERPA_HEALTH_TTL=15
SHERPA_HEALTH_TIMEOUT=1
# 検索経路の可用性判定（SC-6e の 422・索引の実行可否）の接続タイムアウト秒。閉域の遅い
SHERPA_ES_AVAILABLE_TIMEOUT=1
SHERPA_GRAPH_AVAILABLE_TIMEOUT=1
SHERPA_HEALTH_AI_TTL=60
SHERPA_HEALTH_AI_TIMEOUT=8
# グラフ画面の初期表示ノード数の上限。
SHERPA_GRAPH_NODE_LIMIT=100
# チャット以外の LLM 呼び出しの利用量記録は常時ON（TOGGLE-RM・2026-09-03 で旧 `SHERPA_USAGE_METERING`
# トグル・system_settings.usage_metering を撤去）。OFF に実益が無く、実際に初回埋め込みコストが

# ============================================================================
# 10. 内部用・テスト用（**手動設定しない**）
# ============================================================================
# SHERPA_ENV / SHERPA_USE_FIXTURES  … make api / make serve が自動で立てる（serve=production・fixtures 無効）
# SHERPA_MCP_WORLD / SHERPA_MCP_SCOPE / SHERPA_MCP_LAYER / SHERPA_MCP_WORLD_ROOT / SHERPA_MCP_ASK_DISABLED / SHERPA_VLM_USABLE /

# ============================================================================
# 11. 必要なときだけ外す（任意の上書き・既定のままなら不要）
#     詳細は docs/manual/90-リファレンス.md
# ============================================================================
# --- 接続先の上書き（別ホスト構成） ---
# ES_URL=http://localhost:9200
# PGHOST=localhost
# PGUSER=sherpa
# PGPASSWORD=sherpa_dev
# PGDATABASE=sherpa
# SHERPA_PG_DSN=host=db-host port=5432 dbname=sherpa user=sherpa password=sherpa_dev
# SHERPA_PG_POOL_MIN=2
# SHERPA_PG_POOL_MAX=10
# SHERPA_PG_POOL_TIMEOUT=10
# --- プロキシ・社内CA（閉域/社内NW） ---
# HTTP_PROXY=http://proxy.internal:8080
# HTTPS_PROXY=http://proxy.internal:8080
# ALL_PROXY=socks5://proxy.internal:1080
# NO_PROXY=localhost,127.0.0.1,::1,db.internal,graph.internal,search.internal
# SSL_CERT_FILE=/etc/ssl/certs/corp-ca.pem            # アプリ本体（urllib）・Codex 共通
# SSL_CERT_DIR=/etc/ssl/certs
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# CURL_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-ca.pem      # Codex CLI（Node 実装のとき）。REQUESTS_CA_BUNDLE/CURL_CA_BUNDLE も設定があれば Codex へ透過
# --- チューニング（既定で十分・実測してから） ---
# SHERPA_ES_CHUNK_LINES=40
# SHERPA_ES_HYBRID_WEIGHT=0.5
# SHERPA_ES_BULK_BATCH_MAX_DOCS=2000
# SHERPA_ES_BULK_BATCH_MAX_BYTES=8388608
# SHERPA_ES_RAG_CHUNKS_FILE_CAP_BYTES=33554432
# SHERPA_ES_RAG_CHUNKS_MAX_ROWS=200000
# SHERPA_ES_RAG_CHUNK_SEARCH_TEXT_MAX_CHARS=20000
# SHERPA_EMBED_FLUSH_CHUNKS=500
# SHERPA_CHAT_ES_EXCERPT_BUDGET_BYTES=262144
# SHERPA_LOG_DIR=data/run
# --- 外部ツール・別経路（使う構成のときだけ） ---
# SHERPA_SOFFICE_BIN=/usr/bin/soffice
# SHERPA_POWERSHELL_BIN=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
# SHERPA_OFFICE_COM_URL=http://127.0.0.1:8091
# SHERPA_OFFICE_COM_TOKEN=
# SHERPA_OFFICE_TRANSFER_MODE=path
# CHROME_PATH=/path/to/chrome
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
