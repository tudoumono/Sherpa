# Sherpa — 環境変数のひな型（開発・本番共通の唯一の例）
#
# 使い方:  開発機（WSL）は  cp .env.example .env  してから編集する（`make bootstrap` が自動でコピー）。
#          本番（閉域サーバ含む）は  cp .env.example /etc/sherpa/sherpa.env  してから、まず本ファイル
#          冒頭の「0. 本番チェックリスト」節を必ず設定する。.env／sherpa.env は git 管理外
#          （秘密はコミットしない）。
# 読み方:  全スクリプト共通で「コマンドラインの明示指定 ＞ この .env ＞ 既定」。別ファイルにしたいときは
#          SHERPA_ENV_FILE=<パス>（本番は /etc/sherpa/sherpa.env）。Makefile／scripts/run-common.sh／
#          scripts/doctor.sh の3か所が同じ既定 `.env` を見る。docker compose にも同じファイルが渡る。
# 書き方:  既定値は**そのまま有効な行**として書いてある（＝このファイルのままで開発機は動く）。
#          「# 」で始まる行は「必要なときだけ外す」もの（別ホストへの接続・秘密・緊急用・開発用）。
# 選び間違いガード: `SHERPA_ENV=production` で env に `CHANGE_ME` を含む値・開発既定のままの
#          `SHERPA_ADMIN_PASSWORD` があると起動を拒否する（`make prod-check` でも事前検知できる）。
#          閉域網へ持ち出す前に「0.」の各項目を実際の値へ書き換えること。
# 節の構成: 0. 本番チェックリスト／1. 接続先・鍵・置き場（インフラ）／2. 初回の起動で一度だけ管理画面の
#          設定へ入る値／3. 大きな資料・遅い環境のときだけ変える値／4. 緊急時の逃げ道・開発用。
#          調整用の細かい値（会話履歴の長さ・検索や取り込みの内部の上限など）はコードの定数で、ここには無い。
# 詳しい説明: docs/manual/90-リファレンス.md（全変数の一覧・同じ節立て）

# ============================================================================
# 0. 本番（閉域サーバ）チェックリスト — 本番ではこの節の項目を必ず設定する
# ============================================================================
# SHERPA_ENV=production            # 本番ガード有効化（fixtures拒否・AUTH_DISABLED無効化・CHANGE_ME/開発既定パスワード拒否・serve必須）
# SHERPA_ADMIN_PASSWORD=Sherpa2026!   # 既定のままでも可（初回ログインで変更を強制）・変えるならここで
# SHERPA_AUDIT_IP_SALT=CHANGE_ME_LONG_RANDOM_SALT
# POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD    # PGPASSWORD も同値に（下記「1. 接続先」参照）
# NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
# SHERPA_KB_DIR=/srv/sherpa/kb
# SHERPA_DERIVED_DIR=/srv/sherpa/derived
# SHERPA_USERS_DIR=/srv/sherpa/users

# ============================================================================
# 1. 接続先・鍵・置き場（インフラ）
# ============================================================================
# --- アプリ待受・ログイン ---
# 初期 admin パスワード（初回ログインで変更を強制・本番は「0.」で必ず実際の値に変更する）
SHERPA_ADMIN_PASSWORD=Sherpa2026!
# 資料フォルダ選択のルート（`:`区切り・既定=/mnt:/srv:/home:/Users。/ は不可＝登録は共有KBへの公開）
SHERPA_BROWSE_ROOTS=/mnt:/srv:/home:/Users
# アプリ待受
SHERPA_HOST=127.0.0.1
SHERPA_PORT=8000
SHERPA_LAN=1
# uvicorn のワーカー数（2 以上は非対応）
SHERPA_UVICORN_WORKERS=1
# セッション cookie の Secure（空=HTTPS で来たときだけ・1=常に付ける）
SHERPA_COOKIE_SECURE=
# 監査ログの IP hash 用 salt（本番は必ずランダムな値にする）
SHERPA_AUDIT_IP_SALT=change-me
# --- ストア（PostgreSQL / Neo4j / Elasticsearch） ---
# DB パスワード（本番は「0.」で必ず実際の値に変更する）
POSTGRES_PASSWORD=sherpa_dev
NEO4J_USER=neo4j
NEO4J_PASSWORD=sherpa_dev
# ストアのポート（compose の公開ポート＝アプリの接続先）
PGPORT=5432
SHERPA_ES_PORT=9200
SHERPA_NEO4J_BOLT_PORT=7687
SHERPA_NEO4J_HTTP_PORT=7474
# compose プロジェクト名（バックアップ／復元が対象にするボリュームの接頭辞）
SHERPA_COMPOSE_PROJECT=sherpa-mvp
# 別ホストのストア用（URL で丸ごと指定・デフォルトはコメントアウト）
# DATABASE_URL=postgresql://sherpa:sherpa_dev@localhost:5432/sherpa
# ES_URL=http://localhost:9200
# NEO4J_URI=bolt://localhost:7687
# PGHOST=localhost
# PGUSER=sherpa
# PGPASSWORD=sherpa_dev
# PGDATABASE=sherpa
# SHERPA_PG_DSN=host=db-host port=5432 dbname=sherpa user=sherpa password=sherpa_dev
# SHERPA_PG_POOL_MIN=2
# SHERPA_PG_POOL_MAX=10
# SHERPA_PG_POOL_TIMEOUT=10
# --- データの置き場（本番は /opt/sherpa の外の固定パスへ・例:/srv/sherpa/...） ---
SHERPA_KB_DIR=./data/kb
SHERPA_USERS_DIR=./data/users
SHERPA_DERIVED_DIR=./data/derived
SHERPA_OBSERVATION_DIR=./data/observations
SHERPA_OCR_MODEL_CACHE=./data/ocr-models
SHERPA_BACKUP_DIR=./data/backups
# サブシステム別ログ（LibreOffice 変換・MD 変換・LLM 埋め込みなど）の出力先。既定は run ログと同じ場所
# SHERPA_LOG_DIR=data/run
# --- 画像内文字の読み取り（OCR・既定ON） ---
# 0 で止める（取り込み・検索は従来どおり動き、画像の中の文字だけ読まれない）。モデルは make ocr-models。
SHERPA_OCR_ENABLED=1
# OCR ワーカーへ読み取り専用で渡す資料フォルダの親（絶対パス・symlink 不可）。空＝登録済みの1本から自動。
SHERPA_OCR_WORLD_ROOT=
# ワーカーコンテナの実行 uid/gid とメモリ上限
SHERPA_OCR_UID=1000
SHERPA_OCR_GID=1000
SHERPA_OCR_MEMORY_LIMIT=8g
# --- 起動・更新・バックアップ ---
# 起動時にアプリ／ストアの応答を待つ秒数・停止時の猶予秒
SHERPA_APP_WAIT=30
SHERPA_STORE_WAIT=120
SHERPA_STOP_WAIT=10
# ポート占有検査を省略する（1・整合検査は残る）。docker が使えない環境で誤検知するときだけ。
SHERPA_SKIP_PORT_CHECK=0
# 更新（--target-dir）時、current 切替前の自動バックアップ（1＝取る）。
SHERPA_BACKUP_BEFORE_SWITCH=1
# --- プロキシ・社内CA（閉域/社内NW） ---
# アプリ本体（Python 標準の urllib＝OpenAI/Ollama/ES への HTTP はすべてこれ）も Codex CLI も、次の標準変数を
# 環境からそのまま読む。
# HTTP_PROXY=http://proxy.internal:8080
# HTTPS_PROXY=http://proxy.internal:8080
# ALL_PROXY=socks5://proxy.internal:1080
# NO_PROXY=localhost,127.0.0.1,::1,db.internal,graph.internal,search.internal
# 小文字版（一部のツールは小文字しか読まない・大文字と同じ値を入れる。両方あるとき Python は小文字を優先）
# http_proxy=
# https_proxy=
# all_proxy=
# no_proxy=
# SSL_CERT_FILE=/etc/ssl/certs/corp-ca.pem            # アプリ本体（urllib）・Codex 共通
# SSL_CERT_DIR=/etc/ssl/certs
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# CURL_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-ca.pem      # Codex CLI（Node 実装のとき）。REQUESTS_CA_BUNDLE/CURL_CA_BUNDLE も設定があれば Codex へ透過
# --- 外部ツール・別経路（使う構成のときだけ） ---
# marp CLI / Chromium の明示パス（未設定なら自動検出＝通常は不要。空文字にすると自動検出が止まるので外したまま）。
# SHERPA_MARP_BIN=/path/to/marp
# CHROME_PATH=/path/to/chrome
# LibreOffice（旧形式 .doc/.xls/.ppt の変換）と Windows 側の Office 連携
# SHERPA_SOFFICE_BIN=/usr/bin/soffice
# SHERPA_POWERSHELL_BIN=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
# SHERPA_OFFICE_COM_URL=http://127.0.0.1:8091
# SHERPA_OFFICE_COM_TOKEN=
# SHERPA_OFFICE_TRANSFER_MODE=path

# ============================================================================
# 2. 初回の起動で一度だけ管理画面の設定へ入る値
#    画面（システム管理）と同じ値の初回シード。初回だけ使われ、以後は管理画面の値が正
#    （ここを書き換えても反映されない）。
# ============================================================================
# 閉域キット導入時の Codex CLI 自己認証専用の OpenAI キー（空のまま配布・値を入れない限り無害）。
# アプリ本体の OpenAI キー・接続先・埋め込みモデル名は初回起動時にここから取り込まれ、以後は管理画面
# （システム管理「AIプロバイダ（クラウド）」）で管理する。プレースホルダは入れない＝空のまま。
OPENAI_API_KEY=
# ローカルLLM（Ollama）の接続先。初回起動時に管理画面の中央既定値へ一度だけ取り込まれる。
OLLAMA_URL=http://localhost:11434
# チャットの同時実行の上限（背景実行の受付・超過は 429）。1 ユーザーあたり／全体。
SHERPA_CHAT_MAX_TURNS_PER_USER=2
SHERPA_CHAT_MAX_TURNS_GLOBAL=8
# Codex の web_search を管理者が許可する。既定は不許可（社内資料接地の原則）。
SHERPA_ALLOW_WEB_SEARCH=0
# Codex の推論深さ（管理画面「Codex の考えさせる量」の初期値・既定 medium）。
SHERPA_CODEX_REASONING=medium
# 資料検索のヒット件数／精読の窓の行数／影響分析・原因調査でたどる段数の基準値（管理画面「調べる深さ」の初期値）。
SHERPA_GREP_MAX_HITS=45
SHERPA_READ_WINDOW=60
SHERPA_IMPACT_MAX_DEPTH=10
SHERPA_TROUBLESHOOT_GRAPH_DEPTH=4
# 取り込みの読み取り方式（カンマ区切り・管理画面「取り込み設定」の初期値）。ooxml=docx/pptx/xlsx（常時）／
# pdf_text=PDF テキスト層／vision=画像・スキャン PDF の視覚読み取り。
SHERPA_ARMS=ooxml,pdf_text
# 旧形式（.doc/.xls/.ppt）の変換: none（未対応表示）| libreoffice（Linux の soffice）| office_com（Windows 側の Office）。
SHERPA_LEGACY_BACKEND=none
# 個人ファイル 1 件の上限バイト（既定 10 MiB）／保持日数（既定 90・0 で無期限）。管理画面「個人ファイルの上限」の初期値。
SHERPA_WORKSPACE_MAX_BYTES=10485760
SHERPA_WORKSPACE_TTL_DAYS=90
# 頭脳（codex | simple）の初回シード: 頭脳を選んでいない既存利用者全員へ一度だけ保存する（新規利用者は自動選択）。
# SHERPA_AGENT=simple
# 旧版で画像の読み取りだけ別の Ollama を指していた環境用: 中央の Ollama 接続先が未設定のときだけ取り込む。
# SHERPA_VLM_OLLAMA_URL=

# ============================================================================
# 3. 大きな資料・遅い環境のときだけ変える値（既定のままで足りる・足りないときだけ外す）
# ============================================================================
# --- 取り込み（Office/PDF → Markdown・サイズの入口ガード） ---
# 取り込む Office ファイル／PDF の上限バイト（既定 100 MiB）
# SHERPA_OFFICE_FILE_CAP_BYTES=104857600
# SHERPA_PDF_FILE_CAP_BYTES=104857600
# Office ファイルの展開後サイズの上限バイト（既定 500 MiB・zip 爆弾対策）
# SHERPA_OFFICE_UNCOMPRESSED_CAP_BYTES=524288000
# Excel のセル数の上限（既定 2000000）
# SHERPA_XLSX_CELL_CAP=2000000
# 旧形式 1 件の変換の時間上限（秒・既定 60）
# SHERPA_LEGACY_TIMEOUT=60
# --- 視覚読み取り（OCR/VLM） ---
# PDF を画像化する上限ページ数（既定 20）
# SHERPA_OCR_MAX_PAGES=20
# 視覚読み取り 1 ファイルの時間上限（秒・既定 180）／送る画像 1 枚の上限（MB・既定 20）
# SHERPA_VLM_TIMEOUT=180
# SHERPA_VLM_MAX_IMAGE_MB=20
# --- 検索・原本読み取り ---
# grep で 1 ファイルを走査する上限／精読でディスクから読む上限（バイト・既定 64 MiB）
# SHERPA_GREP_FILE_CAP_BYTES=67108864
# SHERPA_READ_AROUND_FILE_CAP_BYTES=67108864
# 原本読み取りツールが開くファイルの上限（既定 50 MiB）／zip 展開後の上限（既定 200 MiB）／1 回の時間上限（秒・既定 10）
# SHERPA_DOC_READ_MAX_BYTES=52428800
# SHERPA_DOC_READ_MAX_UNZIP_BYTES=209715200
# SHERPA_DOC_READ_MAX_SECONDS=10
# グラフ検索 1 回の時間上限（秒・既定 30）
# SHERPA_NEO4J_QUERY_TIMEOUT_S=30
# --- 外部連携 API ---
# 外部連携 API の変換で受け付けるファイルの上限／原本を配る上限（バイト・既定 50 MiB）
# SHERPA_EXT_CONVERT_MAX_BYTES=52428800
# SHERPA_EXT_DOC_MAX_BYTES=52428800
# --- 稼働確認 ---
# AI の稼働確認の待ち時間（秒・既定 8）。閉域で応答の遅い環境なら延ばす
# SHERPA_HEALTH_AI_TIMEOUT=8

# ============================================================================
# 4. 緊急時の逃げ道・開発用（通常は設定しない）
# ============================================================================
# Codex に MCP 経由で検索/グラフのツールを渡す（既定 1）。0 で旧・事実前渡し経路（緊急時の逃げ道）。
# SHERPA_CODEX_MCP=1
# Codex CLI の read-only サンドボックス（既定 1）。0 で `-s workspace-write` にフォールバック（緊急時のみ・本番は起動拒否）。
# SHERPA_CODEX_SANDBOX=1
# Codex が「次に〜を調べます」の途中経過だけでターンを閉じたとき、同じセッションを resume して続ける回数の上限（既定 3・0 で無効）。
# SHERPA_CODEX_AUTO_CONTINUE=3
# Codex の最終応答を JSON スキーマに固定する（既定 2＝主張つき・1＝主張なしの v1・0＝無効で従来の文面判定）。
# SHERPA_CODEX_OUTPUT_SCHEMA=2
# Codex の 1 ターン（自動継続を含む）の壁時計の上限（秒・既定 5400・0 で無制限）。
# SHERPA_CODEX_WALL_CLOCK_LIMIT_S=5400
# 検索用ベクトル化を止める（テスト用・**設定した時点で無効になる**ので通常は外したまま）。
# SHERPA_DISABLE_EMBED=1
# 開発用の架空資料を使う（`make api` が立てる・本番は起動拒否）。
# SHERPA_USE_FIXTURES=1
# 開発・検証互換用（全リクエストを admin 扱い）。通常利用では設定しない（本番では無視）。
# SHERPA_AUTH_DISABLED=1
